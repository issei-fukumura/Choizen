<% layout('layouts/boilerplate') %>


    <h1>投稿一覧</h1>

    <% if (posts && posts.length> 0) { %>
        <% for(let post of posts) {%>
            <div class="card mb-1">
                <div class="mx-6">
                    <%= post.title %>
                </div>
                <div class="card-body">
                    <%= post.content %>
                </div>
                <a class="btn btn-primary " href="/posts/<%= post._id %>">
                            <%= post.title %>の詳細
                </a>
            </div>
            <% } %>


    <% } else { %>
        <p>投稿がありません。</p>
    <% } %>