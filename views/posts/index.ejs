<% layout('layouts/boilerplate') %>

    <h1>投稿一覧</h1>
    <% if (posts && posts.length> 0) { %>
        <% for(let post of posts) {%>
            <div class="offset-3 col-6 mb-1">
                <h2><a href="/posts/<%= post.id %>">
                        <%= post.profiles?.username || '匿名' %>
                    </a></h2>
                <div class="card-body">
                    <%= post.content %>
                </div>
                <div class="post-foot">
                    <% if (currentUser) { %>
                        <form action="/posts/<%= post.id %>/like" method="POST">
                            <button class="like-btn <%= likedIds.has(post.id) ? 'is-liked' : '' %>" type="submit">
                                ♥ <%= post.likes[0].count %>
                            </button>
                        </form>
                        <% } else { %>
                            <span class="meta">♥ <%= post.likes[0].count %></span>
                            <% } %>
                                <a class="text-link" href="/posts/<%= post.id %>">詳しく見る</a>
                </div>
            </div>
            <% } %>
                <% } else { %>
                    <div class="empty">
                        <p>まだ投稿がありません。</p>
                    </div>
                    <% } %>