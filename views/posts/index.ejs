<% layout('layouts/boilerplate') %>

    <h1>投稿一覧</h1>
    <% if (posts && posts.length> 0) { %>
        <% for(let post of posts) {%>
            <div class="card offset-3 col-6 mb-1">
                <div class="m-2">
                    <%= post.title%>
                </div>
                <div class="card-body">
                    <%= post.content %>
                </div>
                <a class="btn btn-primary align-self-start m-1" href="/posts/<%= post.id %>">
                    投稿の詳細
                </a>
                <form action="/posts/<%= post.id %>/like" method="POST" class="d-inline">
                    <button class="btn btn-sm <%= likedIds.has(post.id) ? 'btn-danger' : 'btn-outline-danger' %>">
                        ♥ <%= post.likes[0].count %>
                    </button>
                </form>
            </div>
            <% } %>
                <% } %>