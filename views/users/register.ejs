<% layout('layouts/boilerplate') %>

<div class="card">
    <p class="kicker">SIGN UP</p>
    <h1>新規登録</h1>
    <p class="lede">メールアドレスとパスワードだけで始められます。</p>

    <form action="/users/register" method="POST" class="validated-form mt-4" novalidate>
        <div class="mb-3">
            <label for="email" class="form-label">メールアドレス</label>
            <input type="email" class="form-control" id="email" name="email" placeholder="choizen@example.com" required autocomplete="email">
        </div>
        <div class="mb-4">
            <label for="password" class="form-label">パスワード</label>
            <input type="password" class="form-control" id="password" name="password" minlength="8"
                placeholder="8文字以上" required autocomplete="new-password">
            <div class="invalid-feedback">8文字以上で入力してください</div>
        </div>
        <button type="submit" class="btn-accent">登録する</button>
    </form>
    <p class="switch">すでにアカウントがある場合は <a class="text-link" href="/users/login">ログイン</a></p>
</div>

